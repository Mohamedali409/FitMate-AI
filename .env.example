# ==============================================================================
# FitMate AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local development setup.
# Never commit .env or actual production credentials to version control.
# ==============================================================================

# Application & Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# Database (MongoDB Replica Set)
# Note: Multi-document ACID transactions strictly require a replica set connection URI.
MONGODB_URI=mongodb://localhost:27017/fitmate_ai?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# In-Memory Cache & Rate Limiting (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=fitmate:

# Security & Secrets (Placeholders — Generate 64-char hex strings in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_prod_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_DAYS=30
KMS_RECOVERY_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

