# FitMate AI Frontend Configuration
# URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Toggle mock adapters for offline / preview development ('true' | 'false')
# When true, all requests use the high-fidelity mock adapter layer.
# When false, real backend endpoints are called.
NEXT_PUBLIC_USE_MOCKS=true

# Default display language ('en' | 'ar')
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Default measurement unit system ('metric' | 'imperial')
NEXT_PUBLIC_DEFAULT_UNIT_SYSTEM=metric

